# Copy to .env, generate a private password, and never commit .env.
PWR_POSTGRES_USER=platform_owner
PWR_POSTGRES_DB=platform_work_reform
PWR_POSTGRES_PASSWORD=
PWR_POSTGRES_HOST=127.0.0.1
PWR_POSTGRES_PORT=55432
# Default preserves the original Docker volume. The optional pgdata_home volume
# requires an existing absolute PWR_POSTGRES_DATA_DIR and an explicit migration.
PWR_POSTGRES_VOLUME=pgdata
# PWR_POSTGRES_DATA_DIR=/absolute/path/to/data/pgdata-home
